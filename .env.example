# ==============================================================================
# BIBO Environment Configuration Template
# Copy this file to .env.local for development.
# Configure these variables in the hosting provider dashboard (e.g., Vercel) for production.
# NEVER commit real credentials or secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string with PgBouncer for runtime queries.
# Format: postgresql://<user>:<password>@<endpoint>-pooler.<region>.azure.neon.tech/<dbname>?sslmode=require&connection_limit=20
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&connection_limit=20"

# Direct (unpooled) connection string used exclusively by Prisma CLI for running migrations.
# Format: postgresql://<user>:<password>@<endpoint>.<region>.azure.neon.tech/<dbname>?sslmode=require
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional alias for DATABASE_URL used by Neon serverless driver
POSTGRES_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&connection_limit=20"

# Optional Neon branch name for deployment telemetry (e.g. 'main', 'production')
NEON_BRANCH="production"

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & SESSIONS
# ------------------------------------------------------------------------------
# High-entropy 256-bit secret used to cryptographically sign HMAC-SHA256 session tokens.
# Generate in terminal: openssl rand -base64 32
SESSION_SECRET="replace-with-a-secure-random-256-bit-key-via-openssl-rand-base64-32"

# Canonical public origin of the deployed application (used for OAuth redirects and CORS)
# Production: https://playbibo.com or https://your-project.vercel.app
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION PROVIDERS (Google OAuth 2.0)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client credentials.
# Authorized Redirect URI must match: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID="sample-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="sample-google-client-secret"

# ------------------------------------------------------------------------------
# 4. OPTIONAL INTEGRATIONS (Neon Managed Better Auth & Realtime)
# ------------------------------------------------------------------------------
# If utilizing Neon's managed authentication service:
# NEON_AUTH_BASE_URL="https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth"
# NEON_AUTH_JWKS_URL="https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# If utilizing Neon Realtime WebSocket channels:
# NEON_REALTIME_URL="wss://<endpoint>.realtime.<region>.aws.neon.tech/v1"
# NEON_REALTIME_SECRET="nrt_live_sample_secret"
